{
  "name": "sunfield-farm",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "main": "worker.mjs",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunfield-farm-db",
      "database_id": "84ad0807-9242-4d5c-a130-600bd4c446c4",
      "migrations_dir": "migrations"
    }
  ]
}
